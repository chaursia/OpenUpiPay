# ============================================================
# OpenPayUPI — Git Ignore Configuration
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Cache
.next/
out/
build/
dist/

# Environment Files (Keep .example files tracked)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env.local

# Allow example config files to be tracked in Git
!.env.example
!.env.local.example

# Logs & Debugging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Metadata & Cache
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configs
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Temporary files
*.tmp
*.temp
.temp/
.tmp/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
